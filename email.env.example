# ============================================================
# LaserPrep email and Nextcloud configuration
#
# Copy this file to:
# ~/.config/laserprep/email.env
#
# Replace all example values with your actual credentials.
# Never commit the real email.env file to Git.
# ============================================================

# ------------------------------------------------------------
# SMTP settings
# ------------------------------------------------------------

SMTP_HOST=smtp.example.org
SMTP_PORT=465
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=laserprep@example.org

# ------------------------------------------------------------
# Nextcloud settings
# ------------------------------------------------------------

NEXTCLOUD_URL=https://cloud.example.org
NEXTCLOUD_USERNAME=your-nextcloud-username
NEXTCLOUD_APP_PASSWORD=your-nextcloud-app-password
